{
  "name": "hafta-fisioterapi",
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed:dummy": "tsx --env-file-if-exists=.env scripts/seed-dummy-users.ts",
    "db:seed:dummy:remove": "tsx --env-file-if-exists=.env scripts/remove-dummy-users.ts",
    "db:seed:dummy:removeAll": "tsx --env-file-if-exists=.env scripts/remove-dummy-data.ts",
    "db:seed:dummyPatients": "tsx --env-file-if-exists=.env scripts/seed-dummy-patients.ts",
    "db:seed:dummyIntakes": "tsx --env-file-if-exists=.env scripts/seed-dummy-intakes.ts",
    "db:seed:dummyAppointments": "tsx --env-file-if-exists=.env scripts/seed-dummy-appointments.ts",
    "db:seed:superadmin": "tsx --env-file-if-exists=.env scripts/bootstrap-super-admin.ts",
    "db:reset:production": "tsx --env-file-if-exists=.env scripts/reset-production-db.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "next": "latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.85.0",
    "recharts": "2.15.3",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "@hyperline/react-pdf-tailwind": "^2.3.0",
    "@react-pdf/renderer": "^4.8.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "drizzle-kit": "^0.30.6",
    "eslint": "^9.0.0",
    "eslint-config-next": "latest",
    "postcss": "^8.5.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
